Options -Indexes
Require all granted
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|cgi|pl|py|asp|aspx|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([a-f0-9]{32}\.(?:jpg|png|webp))$ ../../image.php?file=$1 [L,QSA]
</IfModule>
